# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.python313/
.venv/
venv/
env/
ENV/

# Build and packaging artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg

# Test, coverage, and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Local environment variables
.env
.env.*
!.env.example
!.env.template

# IDE settings
.idea/
.vscode/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log

# Data — MUST NOT be committed (IEX terms; each member downloads their own).
# Keep the directory structure but ignore the bars and derived artifacts.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
results/*
!results/.gitkeep
